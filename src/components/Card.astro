---
import { twMerge } from 'tailwind-merge'

const { class: className, ...props } = Astro.props
---

<div
  class={twMerge('grid justify-center w-full h-auto aspect-square', className)}
  {...props}>
  <div class="col-start-1 row-start-1 [&_img]:size-full [&_img]:object-cover">
    <slot name="image" />
  </div>
  <div class="col-start-1 row-start-1 grid content-end gap-y-1 p-6 text-center">
    {
      Astro.slots.title && (
        <p class="text-base/1.2">
          <slot name="title" />
        </p>
      )
    }
    {
      Astro.slots.subtitle && (
        <p class="text-sm/1.2 text-gray">
          <slot name="subtitle" />
        </p>
      )
    }
  </div>
</div>
