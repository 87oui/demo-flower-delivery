---
import { twMerge } from 'tailwind-merge'

const { class: className, ...props } = Astro.props
---

<div
  class={twMerge(
    'group pointer-events-none grid aspect-square h-auto w-full justify-center overflow-clip',
    className
  )}
  {...props}>
  <div
    class="relative col-start-1 row-start-1 [&_img]:size-full [&_img]:object-cover [&_img]:transition-transform [&_img]:duration-500 group-hover:[&_img]:scale-115 group-hover:[&_img]:duration-400">
    <slot name="image" />
  </div>
  <div
    class="relative z-10 col-start-1 row-start-1 grid content-end gap-y-1 p-6 text-center">
    {
      Astro.slots.title && (
        <p class="text-base/1.2 pointer-events-auto">
          <slot name="title" />
        </p>
      )
    }
    {
      Astro.slots.subtitle && (
        <p class="text-sm/1.2 text-gray pointer-events-auto">
          <slot name="subtitle" />
        </p>
      )
    }
  </div>
</div>
